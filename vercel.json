{
  "buildCommand": "pnpm install && pnpm --filter @workspace/squawk run build",
  "outputDirectory": "artifacts/squawk/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_API_SERVER_URL/api/:path*"
    },
    {
      "source": "/((?!assets|logo|promo|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
