# =============================================================================
# Squawk — Environment Variables
# Copy this file to .env and fill in your values.
# On Vercel, set these in Project Settings → Environment Variables.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Vercel Postgres: get from Vercel dashboard → Storage → Postgres → .env.local
# Neon, Supabase, Railway, etc. also work.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get these from clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Vite exposes vars prefixed with VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk proxy URL — leave empty in development, set to your Vercel app URL in production
# Example: https://your-app.vercel.app
VITE_CLERK_PROXY_URL=

# ── File Storage (Vercel Blob) ────────────────────────────────────────────────
# Required on Vercel for photo/video uploads.
# Get from: Vercel dashboard → Storage → Blob → Create Store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# ── NFT / Monad RPC ──────────────────────────────────────────────────────────
# Optional: public Monad testnet RPC endpoint for NFT stats
# Defaults to https://testnet-rpc.monad.xyz if not set
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ── API URL (frontend → backend) ─────────────────────────────────────────────
# On Vercel, the frontend and API are on the same domain — leave this empty.
# Only set if you're hosting the API separately (e.g. Railway).
VITE_API_URL=

# ── Runtime (Replit / local dev only) ────────────────────────────────────────
# These are set automatically by Replit and are NOT needed on Vercel.
# PORT=5000
# BASE_PATH=/
